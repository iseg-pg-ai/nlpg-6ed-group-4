@startuml level-three
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

' THE MAGIC TRICK: Forces strict 90-degree angles instead of curved spaghetti lines
skinparam linetype ortho
skinparam nodesep 100

LAYOUT_TOP_DOWN()

title Component Diagram: Python RAG Application

System_Ext(mlflow, "MLflow Tracking Server", "Python", "Logs evaluation metrics")

Container_Boundary(python_app, "Python RAG Application") {
    
    ' TOP LAYER (Entry Points)
    Component(eval_engine, "Evaluation Engine", "evaluate.py", "Runs batched 2-pass evaluation, DeepEval scoring, and NLP metrics.")
    Component(ingest, "Ingestion Pipeline", "ingest.py", "Reads PDFs/TXTs, chunks text, and orchestrates embedding.")
    
    ' SECOND LAYER
    Component(guardrails, "Guardrails Engine", "guardrails.py", "Intercepts intents and enforces conversational security.")
    
    ' THIRD LAYER (Core Business Logic)
    Component(rag_orch, "RAG Orchestrator", "rag.py", "Injects retrieved context into prompts and parses output.")
    Component(retriever, "Retrieval & Reranking", "retriever.py", "Translates query to vector, fetches from DB, and scores chunks.")
    
    ' BOTTOM LAYER (Core Adapters)
    Component(llm_client, "LLM API Client", "lm_studio_utils.py", "Handles API requests, VRAM limits, and dynamic loading.")
    Component(db_adapter, "Database Adapter", "db_utils.py", "Manages connection pooling, hybrid search, and batch inserts.")

    ' Invisible constraints to force a clean 2-column grid
    Lay_R(eval_engine, ingest)
    Lay_R(rag_orch, retriever)
    Lay_R(llm_client, db_adapter)
}

System_Ext(lmstudio, "LM Studio Server", "C++ / llama.cpp", "Hosts local models")
SystemDb_Ext(pgvector, "PostgreSQL (PGVector)", "Relational & Vector DB", "Stores chunks and vectors")

' --- RELATIONSHIPS ---

' 1. Evaluation & Ingestion Flow (From the top)
Rel_R(eval_engine, mlflow, "Logs runs")
Rel_D(eval_engine, guardrails, "Feeds Golden Set")
Rel_D(eval_engine, llm_client, "Scores as Judge")

Rel_D(ingest, db_adapter, "Saves chunks")
Rel_D(ingest, llm_client, "Embeds chunks")

' 2. Guardrails Flow
Rel_D(guardrails, rag_orch, "Triggers if safe")
Rel_D(guardrails, llm_client, "Checks Intent")

' 3. RAG & Retrieval Flow
Rel_R(rag_orch, retriever, "Requests context")
Rel_D(rag_orch, llm_client, "Generates answer")

Rel_D(retriever, db_adapter, "Fetches chunks")
Rel_D(retriever, llm_client, "Embeds & Reranks")

' 4. External Infrastructure Flow
Rel_D(llm_client, lmstudio, "API Calls")
Rel_D(db_adapter, pgvector, "Reads/Writes")

@enduml