# ==========================================
# 1. LOCAL LLM SETTINGS (OpenAI-compatible)
# ==========================================
LLM_BASE_URL="http://localhost:1234/v1"

# Most OpenAI-compatible clients require an API key string, even if it's fake.
LLM_API_KEY="local-dummy-key"

# The exact model names to use in the code (ensures consistency)
MODEL_A="ministral-3-3b-instruct-2512"
MODEL_B="qwen3.5-2b"
JUDGE_MODEL="deepseek-ai_deepseek-r1-0528-qwen3-8b"

# ==========================================
# 2. PGVECTOR DATABASE SETTINGS
# ==========================================
POSTGRES_USER="root"
POSTGRES_PASSWORD="iseg"
POSTGRES_DB="rag_db"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"

# ==========================================
# 3. MLFLOW & EVALUATION SETTINGS
# ==========================================
# The local port where MLflow will spin up the UI
MLFLOW_TRACKING_URI="http://127.0.0.1:5000"

# DeepEval with a local model as the judge needs to explicitly tell it to skip OpenAI keys.
OPENAI_API_KEY="sk-dummy-key-for-deepeval"

# ==========================================
# 4. RAG HYPERPARAMETERS
# ==========================================
DATA_DIR="./data"

# Embedding settings (If you change the model, you MUST update the dimension!)
# e.g., all-MiniLM-L6-v2 is 384. openai's text-embedding-ada-002 is 1536.
EMBEDDING_MODEL_NAME="text-embedding-nomic-embed-text-v1.5"
VECTOR_DIM="768"

# Chunking strategy
CHUNK_SIZE="500"
CHUNK_OVERLAP="50"

# Number of chunks to retrieve for context
RETRIEVAL_TOP_K="500"
RERANK_TOP_K="10"